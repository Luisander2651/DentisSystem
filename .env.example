APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Spec 015: safe by default. Turn debug on only in your own local .env.
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# stderr reaches Loki through Alloy (docs/observability.md).
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true   # production (https only)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
# Seconds before predis gives up on Redis (connection and read/write); they bound /up.
REDIS_TIMEOUT=2
REDIS_READ_WRITE_TIMEOUT=2

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_APPOINTMENT_TEMPLATE_SID=

BREVO_EMAIL_SENDER_API_KEY=
BREVO_RESET_PASSWORD_TEMPLATE_ID=

# SANCTUM_STATEFUL_DOMAINS=
# SANCTUM_TOKEN_EXPIRATION=
# SANCTUM_TOKEN_PREFIX=

VITE_APP_NAME="${APP_NAME}"

GRAFANA_PASSWORD=

# Spec 015: emergency switch, sends the CSP as Report-Only (docs/deployment.md).
CSP_REPORT_ONLY=false

# Production only (docs/deployment.md): the production clone uses the production Compose
# file, the image tag in service and the Compose project of the manual stack's data volumes.
# COMPOSE_FILE=docker-compose.prod.yml
APP_VERSION=
# DATA_VOLUME_PREFIX=
